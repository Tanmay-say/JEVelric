# --- LLM (Groq primary; OpenRouter free fallback; Gemini disabled unless selected) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER=groq
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.0

# --- Paths ---
DATA_DIR=./data
ANSWERS_DIR=./cases

# --- Calibration (not README rules) ---
CAL_CARD_WINDOW_HOURS=48
CAL_CUSTOMER_HISTORY_DAYS=120
CAL_SHARED_ORIGIN_WINDOW_DAYS=30
CAL_SIMILAR_CASES_TOP_K=5

# --- TigerGraph submission backend; CSV remains the development default ---
TG_HOST=
TG_SECRET=
TG_GRAPHNAME=HHGOA
GRAPH_BACKEND=csv

# --- Optional Jev / TypeSafe (leave disabled; LLM/heuristic signals are used) ---
JEV_ENABLED=false
JEV_API_KEY=
JEV_BASE_URL=
